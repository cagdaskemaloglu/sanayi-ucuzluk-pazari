# Faz 2 — Sanity kurulumundan sonra dolduracaksın (aşağıdaki README'ye bak)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# SANITY_API_TOKEN opsiyoneldi, artık ÖDEME SİPARİŞ KAYDI için gerekli.
# sanity.io/manage → projen → API → Tokens → Add API token → "Editor"
# yetkisiyle oluştur, buraya yapıştır. Boş bırakırsan ödeme akışı yine
# çalışır, sadece siparişler Sanity'e kaydedilmez.
SANITY_API_TOKEN=
# Veri setini GİZLİ yaptıktan sonra (sanity.io/manage → Datasets →
# production → Visibility: Private) sitenin içeriği okuyabilmesi için
# ZORUNLU: sanity.io/manage → API → Tokens → "Viewer" yetkili token.
# Siparişlerdeki müşteri bilgilerinin herkese açık olmaması için gerekli.
SANITY_API_READ_TOKEN=

# Faz 6 — Cloudflare Turnstile (opsiyonel, boş bırakılırsa doğrulama
# adımı atlanır — WhatsApp gönderimi engellenmez). İkisi de doldurulmalı.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Not: WhatsApp numarası artık Sanity Studio → Site Ayarları'ndan
# yönetiliyor, burada ayrı bir env değişkenine gerek yok.

# Faz 7 — SEO (opsiyonel, boş bırakılırsa localhost'a düşer, geliştirmeyi
# etkilemez). Canlıya alınca gerçek domain buraya yazılmalı.
NEXT_PUBLIC_SITE_URL=

# Faz 10 — Vercel Analytics için ekstra bir env değişkeni gerekmiyor,
# Vercel'e deploy edilince otomatik aktif olur (localhost'ta veri toplamaz).

# PayTR — "Online Öde" için ZORUNLU. Üçü de doldurulmazsa "Online Öde"
# tıklandığında kullanıcıya "sistem henüz yapılandırılmadı" mesajı gösterilir,
# site kırılmaz. Değerleri PayTR Mağaza Paneli → Destek & Kurulum → Bilgi
# sayfasından al (Mağaza No / Mağaza Parolası / Mağaza Gizli Anahtarı).
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test modu (varsayılan, boş bırakırsan da test modu çalışır).
# Canlıya geçince 0 yaz.
PAYTR_TEST_MODE=1
# Sadece LOCALHOST testi için, opsiyonel: PayTR müşterinin dış IP'sini ister;
# yerelde bu otomatik bulunur (api.ipify.org). Bulunamazsa buraya kendi dış
# IP'ni elle yazabilirsin.
# PAYTR_USER_IP_OVERRIDE=

# Sipariş e-postaları (Resend — resend.com, ayda 3.000 e-posta ücretsiz).
# Online ödeme onaylanınca işletmeye "yeni sipariş", müşteriye "siparişiniz
# alındı" e-postası gider. Boş bırakılırsa e-posta gönderilmez, ödeme akışı
# etkilenmez.
# RESEND_API_KEY: Resend → API Keys → Create API key (Vercel'e Secret olarak).
RESEND_API_KEY=
# Gönderen adres. Domain Resend → Domains'te doğrulanmış olmalı.
ORDER_EMAIL_FROM="Sanayi Ucuzluk Pazarı <siparis@sanayiucuzlukpazari.com>"
# Yeni sipariş bildiriminin gideceği adres(ler), virgülle ayırarak birden
# fazla yazılabilir. Boşsa Sanity Site Ayarları'ndaki e-posta kullanılır.
ORDER_NOTIFICATION_EMAIL=
